# 환경변수 (API 키 등) - 절대 Git에 업로드하지 마세요
.env
# 로컬에 보관하는 API 키 파일 (절대 커밋 금지)
config/APIkey

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# 가상환경
.venv/
venv/
env/

# 출력 결과 (선택적으로 추적 제외)
outputs/
# 재구조화 이전 폴더 (실제 실행 결과·이미지 자산이 들어 있음, 사람이 옮길 때까지 추적 제외)
images/
output/
# 입력 자산 (사진·컬러 패턴은 사람이 배치하는 작업물, 가이드라인만 추적)
inputs/*
!inputs/guides/
!inputs/photos/
!inputs/photos/.gitkeep
!inputs/color_patterns/
!inputs/color_patterns/.gitkeep
inputs/photos/*
!inputs/photos/.gitkeep
inputs/color_patterns/*
!inputs/color_patterns/.gitkeep

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# macOS
.DS_Store

# 로그
*.log

.codegraph

# >>> defs-data-ignore
# 데이터 · 가이드라인 · 결과물 · 비밀키는 절대 커밋/푸시하지 않습니다.
# 원본: DEFS code/defs-data.gitignore  (sync-to-research.sh 가 research 동기화 때도 이 규칙으로 걸러냅니다)

# 데이터 / 가이드라인 / 결과물 폴더 (어느 깊이든)
# 폴더 안의 파일은 모두 제외하고, 폴더 구조용 .gitkeep 만 남깁니다
**/data/**
!**/data/**/
**/dataset/**
!**/dataset/**/
**/datasets/**
!**/datasets/**/
**/input/**
!**/input/**/
**/inputs/**
!**/inputs/**/
**/output/**
!**/output/**/
**/outputs/**
!**/outputs/**/
**/output[_-]*/**
!**/output[_-]*/**/
**/out/**
!**/out/**/
**/result/**
!**/result/**/
**/results/**
!**/results/**/
**/result[_-]*/**
!**/result[_-]*/**/
**/results[_-]*/**
!**/results[_-]*/**/
**/report/**
!**/report/**/
**/reports/**
!**/reports/**/
**/images/**
!**/images/**/
**/images[_-]*/**
!**/images[_-]*/**/
**/imgs/**
!**/imgs/**/
**/img/**
!**/img/**/
**/sample/**
!**/sample/**/
**/samples/**
!**/samples/**/
**/guide/**
!**/guide/**/
**/guides/**
!**/guides/**/
**/guide_img/**
!**/guide_img/**/
**/guide_imgs/**
!**/guide_imgs/**/
**/material-img/**
!**/material-img/**/
**/material-imgs/**
!**/material-imgs/**/
**/fewshot/**
!**/fewshot/**/
**/final_data/**
!**/final_data/**/
**/checkpoint/**
!**/checkpoint/**/
**/checkpoints/**
!**/checkpoints/**/
**/annotated/**
!**/annotated/**/
**/log/**
!**/log/**/
**/logs/**
!**/logs/**/
!**/.gitkeep

